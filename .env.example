# Conexão com pooling (no Neon: "Connection pooling" ligado)
DATABASE_URL="postgresql://usuario:senha@host-pooler:5432/mapigo?sslmode=require&pgbouncer=true"
# Conexão direta, usada nas migrações (no Neon: "Connection pooling" desligado)
DIRECT_URL="postgresql://usuario:senha@host:5432/mapigo?sslmode=require"
# String aleatória longa (ex.: openssl rand -hex 32)
AUTH_SECRET=""
# Endereço público do sistema (usado nos links enviados aos tutores)
APP_URL="https://app.mapigo.com.br"
# Segredo da rotina diária /api/cron (lembretes automáticos)
CRON_SECRET=""
# Integrações de envio (opcional). Sem elas, as mensagens são enviadas manualmente pelo WhatsApp Web.
# O sistema faz POST {to, message, canal} para a URL configurada (ex.: Z-API, Twilio via função própria).
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
# Fuso horário do servidor (agenda e lembretes)
TZ="America/Sao_Paulo"
